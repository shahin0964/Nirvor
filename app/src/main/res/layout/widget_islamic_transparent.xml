<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_islamic_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: Moon & Hijri date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙 ইসলামিক সময়সূচি"
            android:textColor="#34D399"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_islamic_hijri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="১০ জমাদিউল আউয়াল ১৪৪৮"
            android:textColor="#D1D5DB"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Center Card: Sehri & Iftar + Next Waqt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_emerald"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/widget_islamic_sehri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="সেহরি শেষ: ০৪:৫৫ AM"
            android:textColor="#E0F2FE"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_islamic_iftar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ইফতার: ০৫:১৫ PM"
            android:textColor="#FDE047"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5 Prayers Grid Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prayer_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ফজর\n৪:৫৫"
            android:textColor="#F3F4F6"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/prayer_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="যোহর\n১১:৫৮"
            android:textColor="#F3F4F6"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/prayer_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="আসর\n৩:৩৮"
            android:textColor="#F3F4F6"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/prayer_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="মাগরিব\n৫:১৫"
            android:textColor="#F3F4F6"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/prayer_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="এশা\n৬:৩৩"
            android:textColor="#F3F4F6"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
